# ============================================================================
#  Secrets for the LoncherApp portal — loaded by systemd as EnvironmentFile.
#  Copy to the SERVER at:  /etc/schoolpos/loncherapp.env
#     sudo mkdir -p /etc/schoolpos
#     sudo cp loncherapp.env.template /etc/schoolpos/loncherapp.env
#     sudo chown root:root /etc/schoolpos/loncherapp.env
#     sudo chmod 600       /etc/schoolpos/loncherapp.env      # readable by root only
#  These override the JSON (ASP.NET Core config: env vars beat appsettings.*).
#  Nested keys use double underscore "__".  DO NOT commit the filled-in file.
# ============================================================================

# --- Database (SQL Server) ---
ConnectionStrings__Portal=Server=localhost;Database=SchoolPOS_Cloud;User Id=schoolpos;Password=CHANGE_ME;TrustServerCertificate=True;

# --- Vendor console access code ---
Portal__VendorAccessCode=CHANGE_ME

# --- Mercado Pago (payments + webhook + OAuth state) ---
MercadoPago__AccessToken=CHANGE_ME
MercadoPago__WebhookSecret=CHANGE_ME
MercadoPago__StateSecret=CHANGE_ME_RANDOM_LONG_STRING
MercadoPagoOAuth__ClientSecret=CHANGE_ME

# --- SMTP (password recovery / notifications) ---
Smtp__Password=CHANGE_ME

# --- SW Sapien PAC (CFDI) ---
SwCfdi__Password=CHANGE_ME
# SwCfdi__Token=            # optional; leave unset to use User/Password auth
