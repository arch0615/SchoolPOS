<UserControl x:Class="SchoolPOS.Pos.Desktop.Views.TreasuryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <Viewbox Width="26" Height="26" Margin="0,0,10,0">
                <Canvas Width="64" Height="64">
                    <Path Data="M32 21 C 27 13, 17 14, 15 24 C 13 33, 18 51, 27 51 C 30 51, 30 49, 32 49 C 34 49, 34 51, 37 51 C 46 51, 51 33, 49 24 C 47 14, 37 13, 32 21 Z"
                          Stroke="#EFA43B" StrokeThickness="4.5" StrokeLineJoin="Round" />
                    <Path Data="M33 19 C 35 12, 41 9, 46 12" Stroke="#EFA43B" StrokeThickness="3.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M31 19 C 24 9, 15 11, 20 18 C 24 23, 30 22, 31 19 Z" Fill="#5FB03A" />
                </Canvas>
            </Viewbox>
            <TextBlock Text="Tesorería" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
            <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="16,0,0,0" />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Background="Transparent">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" />
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Abrir caja (sin sesión abierta) -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                        Visibility="{Binding NoOpenSession, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="No tienes una caja abierta" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Fondo inicial" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="120" Text="{Binding OpeningFloat, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <Button Content="Abrir caja" Style="{StaticResource PrimaryButton}" Command="{Binding OpenSessionCommand}" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sesión abierta -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                        Visibility="{Binding HasOpenSession, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Caja abierta" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OpenSession.OpenedAtUtc, StringFormat='desde dd/MM/yyyy HH:mm'}"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,10">
                            <TextBlock Text="Fondo inicial" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding OpenSession.OpeningFloat, StringFormat=C2}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>

                        <TextBlock Text="Movimientos de la sesión" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="Ingreso" Margin="0,0,10,0" VerticalAlignment="Center"
                                         IsChecked="{Binding IsIncomeSelected}" />
                            <RadioButton Content="Egreso" Margin="0,0,10,0" VerticalAlignment="Center"
                                         IsChecked="{Binding IsExpenseSelected}" />
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Importe" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="90" Text="{Binding MovementAmount, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Motivo" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="200" Text="{Binding MovementReason, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Content="Registrar" Command="{Binding RegisterMovementCommand}" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" MaxHeight="150" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" Background="White" RowBackground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="90" />
                                <DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat=C2}" Width="100" />
                                <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" />
                                <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAtUtc, StringFormat='dd/MM HH:mm'}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Separator Margin="0,14" />
                        <TextBlock Text="Cerrar caja (arqueo)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Monto contado" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="120" Text="{Binding CountedAmount, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <Button Content="Cerrar caja" Style="{StaticResource PrimaryButton}" Command="{Binding CloseSessionCommand}" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sesiones recientes (solo administrador) -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,4"
                        Visibility="{Binding CanViewAllSessions, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Sesiones recientes" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding RecentSessions}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" MaxHeight="200" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" Background="White" RowBackground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Apertura" Binding="{Binding OpenedAtUtc, StringFormat='dd/MM/yyyy HH:mm'}" Width="140" />
                                <DataGridTextColumn Header="Cierre" Binding="{Binding ClosedAtUtc, StringFormat='dd/MM/yyyy HH:mm'}" Width="140" />
                                <DataGridTextColumn Header="Fondo" Binding="{Binding OpeningFloat, StringFormat=C2}" Width="90" />
                                <DataGridTextColumn Header="Contado" Binding="{Binding CountedAmount, StringFormat=C2}" Width="90" />
                                <DataGridTextColumn Header="Esperado" Binding="{Binding ExpectedAmount, StringFormat=C2}" Width="90" />
                                <DataGridTextColumn Header="Variación" Binding="{Binding Variance, StringFormat=C2}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
