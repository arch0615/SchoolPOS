<UserControl x:Class="SchoolPOS.Pos.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <Viewbox Width="26" Height="26" Margin="0,0,10,0">
                <Canvas Width="64" Height="64">
                    <Path Data="M32 21 C 27 13, 17 14, 15 24 C 13 33, 18 51, 27 51 C 30 51, 30 49, 32 49 C 34 49, 34 51, 37 51 C 46 51, 51 33, 49 24 C 47 14, 37 13, 32 21 Z"
                          Stroke="#EFA43B" StrokeThickness="4.5" StrokeLineJoin="Round" />
                    <Path Data="M33 19 C 35 12, 41 9, 46 12" Stroke="#EFA43B" StrokeThickness="3.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M31 19 C 24 9, 15 11, 20 18 C 24 23, 30 22, 31 19 Z" Fill="#5FB03A" />
                </Canvas>
            </Viewbox>
            <TextBlock Text="Inventario" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Búsqueda + entrada de mercancía -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Buscar por nombre o código…">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Buscar" Command="{Binding RefreshCommand}" />
            <TextBox Grid.Column="2" Width="70" Text="{Binding EntryQuantity, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Cantidad a ingresar" VerticalContentAlignment="Center" />
            <Button Grid.Column="3" Content="Entrada +" Style="{StaticResource PrimaryButton}"
                    Command="{Binding RegisterEntryCommand}" />
        </Grid>

        <!-- Categorías + alta de producto (FR-INV-2) -->
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Categorías y productos" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Selecciona un producto de la lista para editarlo (precio, costo, categoría, mínimo)."
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="Nombre de categoría" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Agregar categoría" Command="{Binding AddCategoryCommand}" VerticalAlignment="Bottom" />
                </Grid>
                <WrapPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="Nombre" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBox Width="180" Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="Código de barras" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBox Width="130" Text="{Binding NewProductBarcode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="Categoría" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <ComboBox Width="140" ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name" SelectedItem="{Binding NewProductCategory}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="Precio" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBox Width="80" Text="{Binding NewProductPrice, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="Costo" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBox Width="80" Text="{Binding NewProductCost, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,6,6">
                        <TextBlock Text="Mínimo" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        <TextBox Width="80" Text="{Binding NewProductMinStock, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                    <Button Content="{Binding SaveProductButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProductCommand}" VerticalAlignment="Bottom" Margin="0,0,6,6" />
                    <Button Content="Nuevo producto" Command="{Binding NewProductCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6"
                            Visibility="{Binding IsEditingProduct, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="Transparent">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" />
        </StatusBar>

        <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" RowBackground="White">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                            <Setter Property="Background" Value="#FDECEA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Código" Binding="{Binding Barcode}" Width="140" />
                <DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat=C2}" Width="100" />
                <DataGridTextColumn Header="Existencias" Binding="{Binding StockOnHand}" Width="120" />
                <DataGridTextColumn Header="Mínimo" Binding="{Binding MinStock}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
