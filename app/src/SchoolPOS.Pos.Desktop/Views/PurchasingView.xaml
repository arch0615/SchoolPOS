<UserControl x:Class="SchoolPOS.Pos.Desktop.Views.PurchasingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <Viewbox Width="26" Height="26" Margin="0,0,10,0">
                <Canvas Width="64" Height="64">
                    <Path Data="M32 21 C 27 13, 17 14, 15 24 C 13 33, 18 51, 27 51 C 30 51, 30 49, 32 49 C 34 49, 34 51, 37 51 C 46 51, 51 33, 49 24 C 47 14, 37 13, 32 21 Z"
                          Stroke="#EFA43B" StrokeThickness="4.5" StrokeLineJoin="Round" />
                    <Path Data="M33 19 C 35 12, 41 9, 46 12" Stroke="#EFA43B" StrokeThickness="3.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M31 19 C 24 9, 15 11, 20 18 C 24 23, 30 22, 31 19 Z" Fill="#5FB03A" />
                </Canvas>
            </Viewbox>
            <TextBlock Text="Compras" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
            <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="16,0,0,0" />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Background="Transparent">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" />
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Proveedores -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Proveedores" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Nombre" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="160" Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="RFC" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="120" Text="{Binding NewSupplierRfc, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Contacto" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="140" Text="{Binding NewSupplierContact, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Teléfono" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="110" Text="{Binding NewSupplierPhone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Correo" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="160" Text="{Binding NewSupplierEmail, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Button Content="Agregar proveedor" Command="{Binding AddSupplierCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Suppliers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Margin="0,0,16,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Nueva orden de compra -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Nueva orden de compra" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Proveedor" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <ComboBox Width="180" ItemsSource="{Binding Suppliers}"
                                          DisplayMemberPath="Name" SelectedItem="{Binding OrderSupplier}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Fecha esperada" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <DatePicker Width="140" SelectedDate="{Binding OrderExpectedDate}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Notas" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="200" Text="{Binding OrderNotes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="El folio lo asigna el sistema de forma consecutiva; no se captura a mano."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,-4,0,10" />

                        <TextBlock Text="Renglones" FontWeight="SemiBold" Margin="0,4,0,6" />
                        <WrapPanel Margin="0,0,0,8">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Producto" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <ComboBox Width="200" ItemsSource="{Binding Products}"
                                          DisplayMemberPath="Name" SelectedItem="{Binding LineProduct}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Cantidad" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="80" Text="{Binding LineQuantity, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Costo unit." Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="90" Text="{Binding LineUnitCost, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <Button Content="Agregar renglón" Command="{Binding AddLineCommand}" VerticalAlignment="Bottom" Margin="0,0,6,6" />
                            <Button Content="Quitar renglón" Command="{Binding RemoveLineCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </WrapPanel>

                        <DataGrid ItemsSource="{Binding OrderLines}" SelectedItem="{Binding SelectedLine}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="150"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" RowBackground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90" />
                                <DataGridTextColumn Header="Costo unit." Binding="{Binding UnitCost, StringFormat=C2}" Width="100" />
                                <DataGridTextColumn Header="Importe" Binding="{Binding LineTotal, StringFormat=C2}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Text="Total de la orden" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding OrderLinesTotal, StringFormat=C2}" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Button Content="Crear orden" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Command="{Binding CreateOrderCommand}" />
                    </StackPanel>
                </Border>

                <!-- Órdenes -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Órdenes de compra" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="180"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" RowBackground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Folio" Binding="{Binding OrderNumber}" Width="110" />
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName}" Width="*" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="100" />
                                <DataGridTextColumn Header="Fecha" Binding="{Binding OrderDate, StringFormat=dd/MM/yyyy}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Marcar enviada" Command="{Binding MarkSentCommand}" />
                            <Button Content="Recibir pendiente" Style="{StaticResource PrimaryButton}" Command="{Binding ReceiveGoodsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Facturas de proveedor -->
                <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Facturas de proveedor" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Proveedor" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <ComboBox Width="160" ItemsSource="{Binding Suppliers}"
                                          DisplayMemberPath="Name" SelectedItem="{Binding InvoiceSupplier}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Orden (opcional)" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <ComboBox Width="140" ItemsSource="{Binding Orders}"
                                          DisplayMemberPath="OrderNumber" SelectedItem="{Binding InvoiceOrder}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Folio de factura" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="120" Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Importe" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="90" Text="{Binding InvoiceAmount, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Fecha de emisión" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <DatePicker Width="130" SelectedDate="{Binding InvoiceIssueDate}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,6,6">
                                <TextBlock Text="Fecha de vencimiento" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <DatePicker Width="130" SelectedDate="{Binding InvoiceDueDate}" />
                            </StackPanel>
                            <Button Content="Registrar factura" Command="{Binding RegisterInvoiceCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </WrapPanel>

                        <DataGrid ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="160"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" RowBackground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding SupplierName}" Width="*" />
                                <DataGridTextColumn Header="Folio" Binding="{Binding InvoiceNumber}" Width="110" />
                                <DataGridTextColumn Header="Importe" Binding="{Binding Amount, StringFormat=C2}" Width="90" />
                                <DataGridTextColumn Header="Pagado" Binding="{Binding AmountPaid, StringFormat=C2}" Width="90" />
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat=C2}" Width="90" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Monto a pagar" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox Width="100" Text="{Binding PaymentAmount, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <Button Content="Registrar pago" Style="{StaticResource PrimaryButton}" Command="{Binding RegisterPaymentCommand}" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
