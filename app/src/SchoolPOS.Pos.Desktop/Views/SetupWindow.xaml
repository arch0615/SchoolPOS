<Window x:Class="SchoolPOS.Pos.Desktop.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoncherApp — Configuración inicial"
        Height="700" Width="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
    <!-- El botón queda anclado abajo y el resto se desplaza: en una caja con pantalla pequeña
         (1024x768 es común) el asistente seguía siendo usable sin cortar el botón. -->
    <DockPanel Margin="32">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button Content="Comenzar" Style="{StaticResource PrimaryButton}" Height="46" FontSize="16"
                    Command="{Binding FinishCommand}" IsDefault="True" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
        <!-- Marca -->
        <StackPanel HorizontalAlignment="Center">
            <Viewbox Width="52" Height="52" HorizontalAlignment="Center">
                <Canvas Width="64" Height="64">
                    <Path Data="M32 21 C 27 13, 17 14, 15 24 C 13 33, 18 51, 27 51 C 30 51, 30 49, 32 49 C 34 49, 34 51, 37 51 C 46 51, 51 33, 49 24 C 47 14, 37 13, 32 21 Z"
                          Stroke="#EFA43B" StrokeThickness="4.5" StrokeLineJoin="Round" />
                    <Path Data="M33 19 C 35 12, 41 9, 46 12" Stroke="#EFA43B" StrokeThickness="3.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M31 19 C 24 9, 15 11, 20 18 C 24 23, 30 22, 31 19 Z" Fill="#5FB03A" />
                </Canvas>
            </Viewbox>
            <TextBlock FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Run Text="Loncher" Foreground="#57A839" /><Run Text="App" Foreground="#F19234" />
            </TextBlock>
            <TextBlock Text="Configuración inicial" FontSize="14" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,18" />
        </StackPanel>

        <!-- Modo de instalación -->
        <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="¿Cómo va a usarse esta computadora?" FontWeight="SemiBold" Margin="0,0,0,8" />
                <RadioButton IsChecked="True" GroupName="Modo">
                    <StackPanel>
                        <TextBlock Text="Es la única caja de la escuela" FontWeight="SemiBold" />
                        <TextBlock Text="Los datos se guardan en esta misma computadora. No requiere servidor."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Modo" Margin="0,8,0,0" IsChecked="{Binding IsServerMode, Mode=TwoWay}">
                    <StackPanel>
                        <TextBlock Text="Conectar a un servidor de la escuela" FontWeight="SemiBold" />
                        <TextBlock Text="Para escuelas con varias cajas compartiendo la misma información."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>

                <StackPanel Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVisibility}}"
                            Margin="24,10,0,0">
                    <TextBlock Text="Servidor (dirección o instancia)" FontWeight="SemiBold" />
                    <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Margin="0,4,0,2" Tag="Ej. 192.168.1.10 o NOMBRE-PC\SQLEXPRESS" />
                    <TextBlock Text="La dirección del equipo donde está instalado SQL Server en la escuela."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,10" />

                    <TextBlock Text="Nombre de la base de datos" FontWeight="SemiBold" />
                    <TextBox Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" Margin="0,4,0,12" />

                    <CheckBox Content="Usar usuario y contraseña de SQL Server (en vez de la cuenta de Windows)"
                              IsChecked="{Binding UseSqlAuth}" Margin="0,0,0,10" />

                    <StackPanel Visibility="{Binding UseSqlAuth, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Usuario de SQL Server" FontWeight="SemiBold" />
                        <TextBox Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Margin="0,4,0,12" />

                        <TextBlock Text="Contraseña de SQL Server" FontWeight="SemiBold" />
                        <PasswordBox x:Name="SqlPasswordBox" Padding="8,6" Margin="0,4,0,0" FontSize="14"
                                     PasswordChanged="SqlPasswordBox_OnPasswordChanged" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Datos de la escuela -->
        <Border Background="White" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock Text="Nombre de la escuela" FontWeight="SemiBold" />
                <TextBox Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Margin="0,4,0,12" />

                <TextBlock Text="Correo del administrador" FontWeight="SemiBold" />
                <TextBox Text="{Binding AdminUser, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Margin="0,4,0,2" />
                <TextBlock Text="Con este usuario entrará al punto de venta."
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12" />

                <TextBlock Text="Contraseña (mínimo 6 caracteres)" FontWeight="SemiBold" />
                <PasswordBox x:Name="PasswordBox" Padding="8,6" Margin="0,4,0,12" FontSize="14"
                             PasswordChanged="PasswordBox_OnPasswordChanged" />

                <TextBlock Text="Repetir contraseña" FontWeight="SemiBold" />
                <PasswordBox x:Name="ConfirmBox" Padding="8,6" Margin="0,4,0,0" FontSize="14"
                             PasswordChanged="ConfirmBox_OnPasswordChanged" />
            </StackPanel>
        </Border>

        <!-- Dónde quedan los datos: el usuario necesita saber qué respaldar -->
        <StackPanel Margin="0,12,0,0">
            <TextBlock Text="Los datos se guardarán en:" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            <TextBlock Text="{Binding DatabasePathText}" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
          </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
