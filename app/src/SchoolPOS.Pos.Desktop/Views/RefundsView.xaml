<UserControl x:Class="SchoolPOS.Pos.Desktop.Views.RefundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="Devoluciones" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom" Background="Transparent">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Ventas recientes -->
            <DockPanel Grid.Column="0" Margin="0,0,20,0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Buscar por alumno o matrícula…">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="Buscar" Command="{Binding RefreshCommand}" />
                </Grid>

                <DataGrid ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAtLocal, StringFormat='dd/MM/yyyy HH:mm'}" Width="130" />
                        <DataGridTextColumn Header="Alumno" Binding="{Binding StudentName}" Width="*" />
                        <DataGridTextColumn Header="Cobro" Binding="{Binding TenderText}" Width="80" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="130" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- Detalle y captura de la devolución -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Renglones a devolver" FontWeight="SemiBold" FontSize="15" />

                    <TextBlock DockPanel.Dock="Top" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding SelectedTenderText, StringFormat='Se reintegra a: {0}'}" />

                    <Border DockPanel.Dock="Top" Background="#FFF4E5" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                            Visibility="{Binding NeedsOpenTill, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"
                                   Text="Esta venta fue en efectivo. Abra su caja en Tesorería: el importe devuelto se registra como salida del cajón." />
                    </Border>

                    <Button DockPanel.Dock="Bottom" Content="Registrar devolución" Style="{StaticResource PrimaryButton}"
                            Height="46" FontSize="16" Margin="0,14,0,0" Command="{Binding RefundCommand}" />

                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Se reingresa el stock y se reintegra el importe proporcional del renglón. La acción queda en la bitácora." />

                    <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,12,0,0"
                              Background="White" RowBackground="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Disp." Binding="{Binding Refundable, StringFormat='0.##'}" Width="60" IsReadOnly="True" />
                            <DataGridTextColumn Header="Devolver" Binding="{Binding QuantityToRefund, UpdateSourceTrigger=LostFocus}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
