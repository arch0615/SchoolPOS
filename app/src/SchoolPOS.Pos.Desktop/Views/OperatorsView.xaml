<UserControl x:Class="SchoolPOS.Pos.Desktop.Views.OperatorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Operadores" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource InkBrush}" Margin="0,0,0,12" />

        <StatusBar DockPanel.Dock="Bottom" Background="Transparent">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,20,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
                    <CheckBox Content="Ver bajas" VerticalAlignment="Center" Margin="12,0,0,0"
                              IsChecked="{Binding IncludeInactive}" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding Operators}" SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="*" />
                        <DataGridTextColumn Header="Rol" Binding="{Binding Role, Converter={StaticResource RoleName}}" Width="110" />
                        <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive}" Width="60" />
                        <DataGridCheckBoxColumn Header="Bloqueado" Binding="{Binding IsLockedOut}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Alta -->
                    <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Nuevo operador" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />

                            <TextBlock Text="Usuario (correo)" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />

                            <TextBlock Text="Contraseña (mínimo 6 caracteres)" Foreground="{StaticResource MutedBrush}" />
                            <PasswordBox x:Name="NewPasswordBox" Padding="8,6" Margin="0,2,0,10"
                                         PasswordChanged="NewPasswordBox_OnPasswordChanged" />

                            <TextBlock Text="Rol" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Margin="0,2,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource RoleName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="Crear operador" Style="{StaticResource PrimaryButton}"
                                    Height="40" Command="{Binding CreateCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Mantenimiento del seleccionado -->
                    <Border Background="White" CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Operador seleccionado" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />

                            <TextBlock Text="Rol" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Margin="0,2,0,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource RoleName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Cambiar rol" Command="{Binding SetRoleCommand}" />

                            <Separator Margin="0,14" />

                            <TextBlock Text="Contraseña nueva" Foreground="{StaticResource MutedBrush}" />
                            <PasswordBox x:Name="ResetPasswordBox" Padding="8,6" Margin="0,2,0,6"
                                         PasswordChanged="ResetPasswordBox_OnPasswordChanged" />
                            <Button Content="Restablecer contraseña" Command="{Binding ResetPasswordCommand}" />

                            <Separator Margin="0,14" />

                            <Button Content="Desbloquear" Command="{Binding UnlockCommand}" />
                            <Button Content="{Binding ToggleActiveText}" Margin="0,6,0,0"
                                    Command="{Binding ToggleActiveCommand}" />

                            <TextBlock Text="La escuela debe conservar al menos un administrador activo."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
