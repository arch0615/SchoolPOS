<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SchoolPOS.Data\SchoolPOS.Data.csproj" />
    <ProjectReference Include="..\SchoolPOS.Domain\SchoolPOS.Domain.csproj" />
    <ProjectReference Include="..\SchoolPOS.Payments.MercadoPago\SchoolPOS.Payments.MercadoPago.csproj" />
    <ProjectReference Include="..\SchoolPOS.Invoicing.Sw\SchoolPOS.Invoicing.Sw.csproj" />
    <ProjectReference Include="..\SchoolPOS.Data.Migrations.Sqlite\SchoolPOS.Data.Migrations.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.13.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="PdfSharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Fuente incrustada para el renderer de PDF (CommissionInvoicePdfRenderer): PDFsharp 6.x no
      trae fuentes base ni depende de las del sistema operativo, así que sin una fuente propia el
      renderizado revienta en cualquier entorno sin las mismas fuentes que un Windows de escritorio
      — como el contenedor Linux donde corre el portal en producción. Roboto, licencia Apache 2.0
      (ver Assets/Fonts/Roboto-LICENSE.txt): libre para redistribuir en un producto comercial.
    -->
    <EmbeddedResource Include="Assets\Fonts\Roboto-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Roboto-Bold.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-SchoolPOS.Portal.Web-a7e3f9c2-8b41-4d6a-9c0e-5f2d1b6a7e84</UserSecretsId>
    <!--
      NU1902: aviso de vulnerabilidad transitiva de MailKit sin versión corregida en el feed.
      Se mantiene como advertencia (visible), no como error, para no bloquear el build.
      Revisar y actualizar MailKit cuando exista una versión sin el aviso.
    -->
    <WarningsNotAsErrors>NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Por si alguien vuelve a crear un secrets.json suelto en esta carpeta por costumbre: el SDK
      Web lo incluiría en la publicación por omisión (así se filtró la config de desarrollo a
      producción una vez). Los secretos de desarrollo van con `dotnet user-secrets`, nunca aquí.
    -->
    <Content Remove="secrets.json" />
  </ItemGroup>

</Project>
