@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}
@section Head {
    <link rel="stylesheet" href="/css/landing-v3.css" asp-append-version="true" />
    <style>
        .bar { max-width:1160px; height:72px; }
        .bar nav { gap:22px; }
        .bar .lnav { gap:26px; }
        .bar .lnav a { font-weight:700; }
        .bar .lnav a:first-child { color:#2563eb; }
    </style>
}

<div class="landing-v3">
    <!-- HERO -->
    <section class="hero" id="inicio">
        <div class="hero-orb orb-a"></div><div class="hero-orb orb-b"></div>
        <div class="landing-container hero-grid">
            <div class="hero-visual reveal">
                <div class="school-scene"><img src="/img/hero-scene.svg" alt="Madre y estudiante frente a la escuela usando la app de saldo" /></div>
            </div>
            <div class="hero-copy reveal">
                <span class="eyebrow">Pagos escolares inteligentes</span>
                <h1>Pagos escolares,<br /><em>simples</em> para las familias.</h1>
                <p>Administra el saldo escolar de tu hijo, recarga en línea y sigue cada gasto desde una sola plataforma segura.</p>
                <div class="hero-actions">
                    <a class="landing-btn primary" href="/Account/Register">Crear cuenta</a>
                    <a class="landing-btn secondary" href="/Account/Login">Ingresar</a>
                </div>
                <div class="hero-note"><span>✓</span> Sin efectivo &nbsp;·&nbsp; <span>✓</span> Saldo abonado al 100%</div>
            </div>
        </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="landing-section" id="como-funciona">
        <div class="landing-container">
            <div class="section-heading reveal"><span></span><h2>Cómo funcionan los pagos escolares</h2><span></span></div>
            <div class="step-grid reveal">
                <article class="step-card"><b>1</b>
                    <div class="step-art"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg></div>
                    <h3>Crea tu cuenta</h3><p>Regístrate como padre o tutor en pocos minutos.</p></article>
                <article class="step-card"><b>2</b>
                    <div class="step-art"><svg viewBox="0 0 24 24"><path d="M20 7H4V5h16z"/><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M12 11v6M9 14h6"/></svg></div>
                    <h3>Vincula a tu hijo</h3><p>Usa su matrícula para conectarlo con su escuela.</p></article>
                <article class="step-card"><b>3</b>
                    <div class="step-art"><svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></div>
                    <h3>Recarga saldo</h3><p>Agrega fondos de forma segura con Mercado Pago.</p></article>
                <article class="step-card"><b>4</b>
                    <div class="step-art"><svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
                    <h3>Sigue los gastos</h3><p>Revisa compras y movimientos en tiempo real.</p></article>
            </div>
        </div>
    </section>

    <!-- BENEFITS -->
    <section class="landing-section" id="padres">
        <div class="landing-container benefits-grid">
            <article class="benefit-panel parents reveal">
                <div>
                    <h3>Beneficios para padres</h3>
                    <ul>
                        <li>Recargas en línea cuando quieras</li>
                        <li>Saldo y gastos en tiempo real</li>
                        <li>Pagos seguros y protegidos</li>
                        <li>Notificaciones importantes de la escuela</li>
                        <li>Varios hijos en una sola cuenta</li>
                    </ul>
                </div>
                <img src="/img/benefit-parents.png" alt="Beneficios para padres" />
            </article>
            <article class="benefit-panel schools reveal" id="escuelas">
                <div>
                    <h3>Beneficios para escuelas</h3>
                    <ul>
                        <li>Cobro sin efectivo</li>
                        <li>Conciliación automática</li>
                        <li>Reportes y analítica en tiempo real</li>
                        <li>Mejor comunicación con los padres</li>
                        <li>Menos carga administrativa</li>
                    </ul>
                </div>
                <img src="/img/benefit-schools.png" alt="Beneficios para escuelas" />
            </article>
        </div>
    </section>

    <!-- SECURITY -->
    <section class="security-band" id="seguridad">
        <div class="landing-container">
            <div class="section-heading reveal"><span></span><h2>Tus pagos son 100% seguros</h2><span></span></div>
            <div class="security-card reveal">
                <div><i class="sec-blue"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></i>
                    <p><strong>Seguridad de nivel bancario</strong><small>Cifrado SSL de 256 bits</small></p></div>
                <div><i class="sec-green"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></i>
                    <p><strong>Transacciones seguras</strong><small>Procesadas por Mercado Pago</small></p></div>
                <div><i class="sec-purple"><svg viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C15.5 3.81 18 5 20 5a1 1 0 0 1 1 1z"/><circle cx="12" cy="11" r="2"/></svg></i>
                    <p><strong>Privacidad protegida</strong><small>No almacenamos tu tarjeta</small></p></div>
                <div><i class="sec-cyan"><svg viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/><path d="M9 13l2 2 4-4"/></svg></i>
                    <p><strong>Plataforma confiable</strong><small>99.9% de disponibilidad</small></p></div>
            </div>
        </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="landing-section">
        <div class="landing-container">
            <div class="section-heading reveal"><span></span><h2>Lo que dicen familias y escuelas</h2><span></span></div>
            <div class="story-grid reveal">
                <div class="story-card"><span class="stars">★★★★★</span>
                    <p>“Administrar los pagos escolares de mis hijos ahora es mucho más fácil; recargo en segundos.”</p>
                    <div class="story-who"><span class="story-avatar" style="background:#2563eb">SJ</span><div><strong>Sofía Jiménez</strong><small>Madre de familia</small></div></div></div>
                <div class="story-card"><span class="stars">★★★★★</span>
                    <p>“La plataforma es simple, segura y el soporte siempre ayuda. ¡Muy recomendada!”</p>
                    <div class="story-who"><span class="story-avatar" style="background:#16a34a">MB</span><div><strong>Miguel Barrera</strong><small>Padre de familia</small></div></div></div>
                <div class="story-card"><span class="stars">★★★★★</span>
                    <p>“Desde que la usamos, la gestión de efectivo es 100% digital y la conciliación es automática.”</p>
                    <div class="story-who"><span class="story-avatar" style="background:#f59e0b">JW</span><div><strong>Colegio Las Palmas</strong><small>Administración escolar</small></div></div></div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="landing-section" id="faq">
        <div class="landing-container">
            <div class="section-heading reveal"><span></span><h2>Preguntas frecuentes</h2><span></span></div>
            <div class="faq-grid reveal">
                <details><summary>¿Cómo creo una cuenta?</summary><p>Regístrate con tu nombre, correo y una contraseña; luego vincula a tu hijo por su matrícula.</p></details>
                <details><summary>¿Mi información de pago está segura?</summary><p>Sí. Mercado Pago procesa el cobro y nunca almacenamos los datos de tu tarjeta.</p></details>
                <details><summary>¿Hay una aplicación móvil?</summary><p>El portal funciona desde el navegador de tu teléfono, sin instalar nada.</p></details>
                <details><summary>¿Cómo agrego dinero al saldo de mi hijo?</summary><p>Elige al estudiante, indica el monto y completa el pago en línea.</p></details>
                <details><summary>¿Puedo seguir sus gastos?</summary><p>Sí. El historial muestra cada recarga y consumo registrado.</p></details>
                <details><summary>¿Cómo se benefician las escuelas?</summary><p>Reducen el efectivo y conectan ventas, inventario, conciliación y reportes.</p></details>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="landing-footer">
        <div class="landing-container footer-grid">
            <div class="footer-brand">
                <img src="/img/favicon.svg" alt="LoncherApp" />
                <p>La forma inteligente y segura de administrar los pagos escolares para una mejor experiencia educativa.</p>
                <div class="footer-social">
                    <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M13 22v-8h3l1-4h-4V8c0-1 .3-2 2-2h2V2.1C18.4 2 17.3 2 16.5 2 13.9 2 12 3.7 12 6.6V10H9v4h3v8z"/></svg></a>
                    <a href="#" aria-label="Twitter"><svg viewBox="0 0 24 24"><path d="M22 5.9c-.7.3-1.5.6-2.3.7.8-.5 1.5-1.3 1.8-2.3-.8.5-1.7.8-2.6 1a4 4 0 0 0-6.9 3.7A11.4 11.4 0 0 1 3.8 4.6a4 4 0 0 0 1.2 5.4c-.6 0-1.2-.2-1.8-.5a4 4 0 0 0 3.2 4 4 4 0 0 1-1.8.1 4 4 0 0 0 3.7 2.8A8 8 0 0 1 2 18.6 11.3 11.3 0 0 0 8.2 20c7.4 0 11.5-6.2 11.5-11.5V8c.8-.6 1.5-1.3 2.1-2.1z"/></svg></a>
                    <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2"/></svg></a>
                    <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM10 9h3.8v1.7h.1c.5-1 1.8-2 3.7-2 4 0 4.7 2.6 4.7 5.9V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21h-4z"/></svg></a>
                </div>
            </div>
            <div><h4>Enlaces</h4><a href="#inicio">Inicio</a><a href="#como-funciona">Cómo funciona</a><a href="#padres">Para padres</a><a href="#escuelas">Para escuelas</a><a href="#faq">Preguntas</a></div>
            <div><h4>Empresa</h4><a href="#">Acerca de</a><a href="#contacto">Contacto</a><a href="#">Aviso de privacidad</a><a href="#">Términos</a></div>
            <div><h4>Soporte</h4><a href="#faq">Centro de ayuda</a><a href="/Account/Login">Ingresar</a><a href="/Vendor/Login">Acceso proveedor</a><a href="#">soporte@loncherapp.com</a></div>
        </div>
        <div class="landing-container footer-copy">© 2026 LoncherApp · Todos los derechos reservados</div>
    </footer>
</div>

<script>
(() => {
    document.body.classList.add('reveal-ready');
    const items = document.querySelectorAll('.landing-v3 .reveal');
    if (!('IntersectionObserver' in window)) { items.forEach(x => x.classList.add('shown')); return; }
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('shown'); io.unobserve(e.target); } }), { threshold: .12 });
    items.forEach(i => io.observe(i));
    const hd = document.querySelector('header');
    const onScroll = () => hd && hd.classList.toggle('scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
})();
</script>
