@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}
<style>
    .lp-wrap { max-width:1100px; margin:0 auto; padding:0 24px; }
    .lp-band { padding:56px 0; }
    .lp-eyebrow { display:inline-block; background:var(--primary-tint); color:var(--primary-dark);
                  font-weight:700; font-size:13px; padding:5px 12px; border-radius:999px; }
    .btn.lg { padding:14px 22px; font-size:16px; }

    /* HERO */
    .hero-band { background:linear-gradient(135deg,#eff6ff,#ffffff); padding:40px 0 52px; position:relative; overflow:hidden; }
    .hero-band::before { content:""; position:absolute; width:280px; height:280px; border-radius:50%; background:#dbeafe; opacity:.5; top:-90px; right:-60px; }
    .hero-band::after { content:""; position:absolute; width:160px; height:160px; border-radius:50%; background:#fde68a; opacity:.35; bottom:-60px; left:-40px; }
    .lp-hero { display:grid; grid-template-columns:1.05fr .95fr; gap:40px; align-items:center; position:relative; z-index:1; }
    .lp-hero h1 { font-size:44px; line-height:1.1; letter-spacing:-.6px; margin:14px 0 14px; }
    .lp-hero .sub { font-size:18px; color:var(--muted); line-height:1.55; margin:0 0 24px; max-width:520px; }
    .lp-cta { display:flex; gap:12px; flex-wrap:wrap; }
    .lp-badges { list-style:none; padding:0; margin:22px 0 0; display:flex; gap:18px; flex-wrap:wrap; }
    .lp-badges li { display:flex; align-items:center; gap:8px; color:#334155; font-size:14px; font-weight:600; }
    .lp-badges svg { width:18px; height:18px; stroke:var(--success); fill:none; stroke-width:2.4; stroke-linecap:round; stroke-linejoin:round; }
    .float img { width:100%; height:auto; }

    /* STATS */
    .stats { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; text-align:center; }
    .stat .n { font-size:40px; font-weight:800; color:var(--primary); letter-spacing:-1px; line-height:1.1; }
    .stat .l { color:var(--muted); font-size:14px; font-weight:600; margin-top:4px; }

    /* SECTION HEADS */
    .sec-head { text-align:center; max-width:640px; margin:0 auto 32px; }
    .sec-head h2 { font-size:30px; margin:0 0 8px; letter-spacing:-.4px; }
    .sec-head p { color:var(--muted); font-size:16px; margin:0; }

    /* ICON TILES */
    .lp-ico { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; background:var(--primary-tint); margin-bottom:12px; }
    .lp-ico svg { width:24px; height:24px; stroke:var(--primary); fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }
    .lp-ico.amber { background:#fef3c7; } .lp-ico.amber svg { stroke:#d97706; }
    .lp-ico.green { background:#dcfce7; } .lp-ico.green svg { stroke:#16a34a; }
    .lp-card h3 { margin:0 0 6px; font-size:17px; } .lp-card p { margin:0; color:var(--muted); font-size:14px; line-height:1.5; }

    /* STEPS */
    .steps { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
    .step { position:relative; } .step .num { position:absolute; top:14px; right:16px; font-size:32px; font-weight:800; color:#eef2f7; }

    /* SPLIT (benefits) */
    .split { display:grid; grid-template-columns:1fr 1fr; gap:44px; align-items:center; }
    .split img { width:100%; height:auto; }
    .flist { list-style:none; padding:0; margin:0; }
    .flist li { display:flex; gap:12px; align-items:flex-start; margin-bottom:16px; }
    .flist .ck { flex:0 0 26px; width:26px; height:26px; border-radius:50%; background:var(--primary-tint); display:flex; align-items:center; justify-content:center; }
    .flist .ck svg { width:15px; height:15px; stroke:var(--primary); fill:none; stroke-width:2.6; stroke-linecap:round; stroke-linejoin:round; }
    .flist b { display:block; font-size:15px; } .flist span { color:var(--muted); font-size:14px; }

    /* SECURITY (dark) */
    .security-band { background:#0f2f6b; color:#fff; }
    .security-band .sec-head h2 { color:#fff; } .security-band .sec-head p { color:#c7d7f5; }
    .sec-cards { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
    .sec-card { background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.16); border-radius:14px; padding:20px; }
    .sec-card .lp-ico { background:rgba(255,255,255,.14); } .sec-card .lp-ico svg { stroke:#fff; }
    .sec-card h3 { margin:0 0 5px; font-size:16px; } .sec-card p { margin:0; color:#c7d7f5; font-size:13px; line-height:1.5; }

    /* PREVIEW */
    .preview { position:relative; max-width:780px; margin:0 auto; }
    .preview img { width:100%; height:auto; display:block; }
    .flabel { position:absolute; background:#fff; box-shadow:0 8px 24px rgba(15,23,42,.14); border-radius:999px;
              padding:9px 15px; font-size:13px; font-weight:700; color:#111827; display:flex; align-items:center; gap:7px; }
    .flabel::before { content:""; width:9px; height:9px; border-radius:50%; background:var(--success); }
    .flabel.a { top:6%; left:-22px; } .flabel.b { top:44%; right:-26px; } .flabel.b::before { background:var(--primary); }
    .flabel.c { bottom:8%; left:8%; } .flabel.c::before { background:var(--warning); }

    /* PHONES */
    .phones { display:flex; justify-content:center; gap:26px; flex-wrap:wrap; }
    .phone { width:186px; height:auto; }

    /* TESTIMONIALS */
    .tcards { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    .tcard .stars { color:#f59e0b; letter-spacing:2px; font-size:14px; margin-bottom:8px; }
    .tcard .quote { font-size:15px; line-height:1.55; color:#334155; margin:0 0 16px; }
    .tcard .who { display:flex; align-items:center; gap:10px; }
    .avatar { width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; color:#fff; font-size:15px; }
    .who b { display:block; font-size:14px; } .who span { color:var(--muted); font-size:12px; }

    /* FAQ */
    .lp-faq details { border-bottom:1px solid var(--line); padding:16px 2px; }
    .lp-faq summary { cursor:pointer; font-weight:600; font-size:16px; list-style:none; display:flex; justify-content:space-between; align-items:center; }
    .lp-faq summary::-webkit-details-marker { display:none; }
    .lp-faq summary::after { content:"+"; color:var(--primary); font-size:22px; font-weight:400; }
    .lp-faq details[open] summary::after { content:"–"; }
    .lp-faq p { color:var(--muted); margin:10px 0 2px; line-height:1.55; }

    /* CTA + FOOTER */
    .cta-band { background:linear-gradient(135deg,#2563eb,#3b82f6); color:#fff; text-align:center; }
    .cta-band h2 { font-size:30px; margin:0 0 8px; } .cta-band p { margin:0 0 22px; opacity:.9; font-size:17px; }
    .cta-band .btn { background:#fff; color:var(--primary-dark); } .cta-band .btn.ghost { background:transparent; color:#fff; border:1px solid rgba(255,255,255,.6); }
    footer.lpf { background:#0b1b3a; color:#94a3b8; padding:46px 0 26px; }
    footer.lpf .cols { display:grid; grid-template-columns:1.6fr 1fr 1fr 1fr; gap:28px; }
    footer.lpf h4 { color:#fff; font-size:14px; margin:0 0 12px; } footer.lpf a { display:block; color:#94a3b8; font-size:14px; margin-bottom:8px; }
    footer.lpf a:hover { color:#fff; text-decoration:none; }
    footer.lpf .brand { color:#fff; font-weight:800; font-size:18px; margin-bottom:8px; }
    footer.lpf .legal { border-top:1px solid rgba(255,255,255,.12); margin-top:28px; padding-top:18px; display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; font-size:13px; }

    /* animation */
    .reveal-ready .reveal { opacity:0; transform:translateY(18px); transition:opacity .6s ease, transform .6s ease; }
    .reveal-ready .reveal.in { opacity:1; transform:none; }
    @@media (prefers-reduced-motion: no-preference) {
        .float img { animation:floaty 5.5s ease-in-out infinite; }
    }
    @@keyframes floaty { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
    @@media (prefers-reduced-motion: reduce) {
        .reveal-ready .reveal { opacity:1; transform:none; transition:none; }
    }
    @@media (max-width:860px) {
        .lp-hero, .split { grid-template-columns:1fr; }
        .lp-hero .art { order:-1; }
        .lp-hero h1 { font-size:34px; }
        .stats, .steps, .sec-cards, .tcards { grid-template-columns:1fr 1fr; }
        footer.lpf .cols { grid-template-columns:1fr 1fr; }
        .flabel { display:none; }
    }
    @@media (max-width:520px) {
        .stats, .steps, .sec-cards, .tcards, footer.lpf .cols { grid-template-columns:1fr; }
        .lp-cta .btn { flex:1; text-align:center; }
    }
</style>

<!-- ===== HERO ===== -->
<section class="hero-band">
    <div class="lp-wrap lp-hero">
        <div class="reveal in">
            <span class="lp-eyebrow">Pagos escolares inteligentes</span>
            <h1>Pagos escolares simples y seguros para tu familia</h1>
            <p class="sub">Administra el saldo escolar de tu hijo, recárgalo en línea y sigue cada gasto
                desde una sola plataforma segura. Sin filas, sin efectivo.</p>
            <div class="lp-cta">
                <a class="btn lg" href="/Account/Register">Crear cuenta</a>
                <a class="btn ghost lg" href="/Account/Login">Ingresar</a>
            </div>
            <ul class="lp-badges">
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Pago seguro con Mercado Pago</li>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Saldo abonado al 100%</li>
            </ul>
        </div>
        <div class="art float"><img src="/img/hero-illustration.svg" alt="Recarga de saldo escolar desde el teléfono" /></div>
    </div>
</section>

<!-- ===== STATS ===== -->
<section class="lp-band"><div class="lp-wrap stats reveal">
    <div class="stat"><div class="n"><span data-count="10000" data-suffix="+">10,000+</span></div><div class="l">Estudiantes atendidos</div></div>
    <div class="stat"><div class="n"><span data-count="500" data-suffix="+">500+</span></div><div class="l">Familias conectadas</div></div>
    <div class="stat"><div class="n"><span data-count="99.9" data-dec="1" data-suffix="%">99.9%</span></div><div class="l">Confiabilidad de pagos</div></div>
    <div class="stat"><div class="n">24/7</div><div class="l">Acceso en línea</div></div>
</div></section>

<!-- ===== HOW IT WORKS ===== -->
<section id="como-funciona" class="lp-band" style="background:#f8fafc">
    <div class="lp-wrap">
        <div class="sec-head reveal"><h2>Cómo funcionan los pagos escolares</h2><p>De la recarga a la compra, en cuatro pasos.</p></div>
        <div class="steps reveal">
            <div class="card lp-card step"><span class="num">1</span>
                <div class="lp-ico"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg></div>
                <h3>Crea tu cuenta</h3><p>Regístrate como padre o tutor en minutos.</p></div>
            <div class="card lp-card step"><span class="num">2</span>
                <div class="lp-ico amber"><svg viewBox="0 0 24 24"><path d="M20 7H4V5h16z"/><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M12 11v6M9 14h6"/></svg></div>
                <h3>Vincula a tu hijo</h3><p>Asócialo con su número de matrícula.</p></div>
            <div class="card lp-card step"><span class="num">3</span>
                <div class="lp-ico green"><svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg></div>
                <h3>Recarga saldo</h3><p>Paga con Mercado Pago; se abona al 100%.</p></div>
            <div class="card lp-card step"><span class="num">4</span>
                <div class="lp-ico"><svg viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div>
                <h3>Sigue los gastos</h3><p>Consulta recargas y consumos en tiempo real.</p></div>
        </div>
    </div>
</section>

<!-- ===== PARENT BENEFITS ===== -->
