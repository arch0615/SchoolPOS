@page
@using SchoolPOS.Domain.Enums
@using SchoolPOS.Portal.Web.Pages.Vendor
@model SchoolPOS.Portal.Web.Pages.Vendor.InvoicesModel
@{
    ViewData["Title"] = "Facturas de comisión";
}

<div class="page-head">
    <div>
        <div class="eyebrow2">Panel del proveedor</div>
        <h1 style="margin:8px 0 0">Facturas de comisión</h1>
        <p class="sub">
            @Model.StampedCount @(Model.StampedCount == 1 ? "timbrada" : "timbradas") por @Model.StampedTotal.ToString("C2")@(Model.FailedCount > 0 ? $" · {Model.FailedCount} {(Model.FailedCount == 1 ? "fallida" : "fallidas")}" : "")
        </p>
    </div>
</div>

<div class="card">
    <form method="get" class="filter-bar">
            <div>
                <label>Escuela</label>
                <select name="SchoolId">
                    <option value="">Todas</option>
                    @foreach (var s in Model.Schools)
                    {
                        <option value="@s.Id" selected="@(Model.SchoolId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div>
                <label>Estado</label>
                <select name="Status">
                    <option value="">Todos</option>
                    @foreach (var st in Enum.GetValues<CfdiStatus>())
                    {
                        <option value="@st" selected="@(Model.Status == st)">@InvoicesModel.StatusLabel(st)</option>
                    }
                </select>
            </div>
            <div><label>&nbsp;</label><button class="btn" type="submit">Filtrar</button></div>
        </form>
</div>

<div class="card">
    @if (Model.Invoices.Count == 0)
    {
        <p class="muted">No hay facturas que coincidan con el filtro.</p>
        <p style="margin-top:12px"><a class="btn ghost" href="/Vendor/Commissions">Ir a comisiones para emitir</a></p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Escuela</th>
                    <th>Periodo</th>
                    <th style="text-align:right">Comisión</th>
                    <th>Estado</th>
                    <th>Folio fiscal (UUID)</th>
                    <th>Emitida</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var inv in Model.Invoices)
            {
                <tr>
                    <td>@inv.SchoolName</td>
                    <td>@inv.PeriodFrom.ToString("dd/MM/yyyy") – @inv.PeriodTo.ToString("dd/MM/yyyy")</td>
                    <td style="text-align:right">@inv.Amount.ToString("C2") <span class="muted">@inv.Currency</span></td>
                    <td>
                        <span class="st @inv.Status.ToString().ToLowerInvariant()">@InvoicesModel.StatusLabel(inv.Status)</span>
                        @if (inv.Status == CfdiStatus.Failed && !string.IsNullOrEmpty(inv.Error))
                        {
                            <div class="muted" style="font-size:12px">@inv.Error</div>
                        }
                    </td>
                    <td class="muted" style="font-size:12px">@inv.Uuid</td>
                    <td class="muted" style="font-size:12px">@((inv.StampedAtUtc ?? inv.CreatedAtUtc).ToString("dd/MM/yyyy HH:mm"))</td>
                </tr>
            }
            </tbody>
        </table>
        <p class="muted" style="margin-top:10px">Se muestran las 100 más recientes que coinciden con el filtro.</p>
    }
</div>
