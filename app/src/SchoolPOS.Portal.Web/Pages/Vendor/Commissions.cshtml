@page
@model SchoolPOS.Portal.Web.Pages.Vendor.CommissionsModel
@{
    ViewData["Title"] = "Comisiones";
    var fromStr = Model.From?.ToString("yyyy-MM-dd");
    var toStr = Model.To?.ToString("yyyy-MM-dd");
    var hasPeriod = Model.From is not null && Model.To is not null;
}

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="msg ok">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="msg error">@Model.Error</div> }

<div class="page-head">
    <div>
        <div class="eyebrow2">Panel del proveedor</div>
        <h1 style="margin:8px 0 0">Comisiones</h1>
        <p class="sub">Desglose por escuela · sólo recargas capturadas</p>
    </div>
</div>

<div class="card">
    <form method="get" class="filter-bar">
        <div><label>Desde</label><input type="date" name="From" value="@fromStr" /></div>
        <div><label>Hasta</label><input type="date" name="To" value="@toStr" /></div>
        <div><label>&nbsp;</label><button class="btn" type="submit">Filtrar</button></div>
    </form>
</div>

<div class="kpi-grid">
    <div class="kpi accent"><div class="n">@Model.Rollup.TotalCommission.ToString("C2")</div><div class="l">Comisión total (tu ingreso)</div></div>
    <div class="kpi amber"><div class="n">@Model.Rollup.TotalRecharged.ToString("C2")</div><div class="l">Total recargado</div></div>
    <div class="kpi"><div class="n">@Model.Rollup.TopUpCount</div><div class="l">Recargas · tasa media @((Model.AverageRate * 100).ToString("0.##"))%</div></div>
</div>

<div class="card">
    <h2>Desglose por escuela</h2>
    @if (Model.Rollup.Schools.Count == 0)
    {
        <p class="muted">Sin recargas capturadas en el periodo.</p>
    }
    else
    {
        @if (!hasPeriod)
        {
            <p class="muted">Selecciona un periodo (Desde y Hasta) para poder emitir facturas.</p>
        }
        <table>
            <thead>
                <tr>
                    <th>Escuela</th>
                    <th style="text-align:right">Recargas</th>
                    <th style="text-align:right">Total recargado</th>
                    <th style="text-align:right">Comisión</th>
                    <th style="text-align:right">Factura</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model.Rollup.Schools)
            {
                <tr>
                    <td>@s.SchoolName</td>
                    <td style="text-align:right">@s.TopUpCount</td>
                    <td style="text-align:right">@s.TotalRecharged.ToString("C2")</td>
                    <td style="text-align:right;font-weight:700;color:var(--success)">@s.TotalCommission.ToString("C2")</td>
                    <td style="text-align:right">
                        <form method="post" asp-page-handler="Issue" style="display:inline">
                            <input type="hidden" name="schoolId" value="@s.SchoolId" />
                            <input type="hidden" name="from" value="@fromStr" />
                            <input type="hidden" name="to" value="@toStr" />
                            <button class="btn ghost" type="submit" style="padding:6px 10px;min-width:0"
                                    disabled="@(!hasPeriod)">Emitir CFDI</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr style="border-top:2px solid var(--line)">
                    <td style="font-weight:700">Total</td>
                    <td style="text-align:right;font-weight:700">@Model.Rollup.TopUpCount</td>
                    <td style="text-align:right;font-weight:700">@Model.Rollup.TotalRecharged.ToString("C2")</td>
                    <td style="text-align:right;font-weight:700;color:var(--success)">@Model.Rollup.TotalCommission.ToString("C2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        <p class="muted" style="margin-top:8px">
            La factura se emite por el periodo seleccionado. En desarrollo el timbrado es simulado.
            Las facturas emitidas se consultan en <a href="/Vendor/Invoices">Facturas</a>.
        </p>
    }
</div>

<div class="card">
    <p class="muted">La comisión se separa automáticamente a tu cuenta en la pasarela (split de Mercado Pago).
        Cada escuela recibe además su factura/CFDI por la comisión.</p>
</div>
