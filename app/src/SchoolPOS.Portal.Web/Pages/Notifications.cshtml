@page
@model SchoolPOS.Portal.Web.Pages.NotificationsModel
@{
    ViewData["Title"] = "Avisos";
}

@section Head {
    <style>
        .pref { display: flex; align-items: center; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--line); }
        .pref:last-of-type { border-bottom: 0; }
        .pref .pico { width: 42px; height: 42px; flex: 0 0 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; }
        .pref .txt { flex: 1; min-width: 0; }
        .pref .txt strong { display: block; font-size: 15px; font-weight: 600; }
        .pref .txt span { color: var(--muted); font-size: 13px; }
        /* Interruptor sobre un checkbox real: sin JS y accesible con teclado. */
        .sw { position: relative; flex: 0 0 46px; width: 46px; height: 26px; }
        .sw input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
        .sw .track { position: absolute; inset: 0; background: #cbd5e1; border-radius: 999px; transition: background .15s; pointer-events: none; }
        .sw .track::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px;
                            background: #fff; border-radius: 50%; transition: transform .15s; }
        .sw input:checked + .track { background: var(--primary); }
        .sw input:checked + .track::after { transform: translateX(20px); }
        .sw input:focus-visible + .track { box-shadow: 0 0 0 3px rgba(37,99,235,.35); }
    </style>
}

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="msg ok">@Model.Message</div> }

<div class="page-head with-illus">
    <div>
        <div class="eyebrow2">Cuenta</div>
        <h1 style="margin:8px 0 0">Avisos</h1>
        <p class="sub">Elige qué quieres que te avisemos. Puedes cambiarlo cuando quieras.</p>
    </div>
    <img class="head-illus" src="/img/il/il-bell.svg" alt="" aria-hidden="true" />
</div>

<form method="post">
    <div class="card">
        <div class="pref">
            <span class="pico" style="background:#e7f9ee;color:#16a34a" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
            </span>
            <label class="sw">
                <input type="checkbox" asp-for="LowBalance" />
                <span class="track"></span>
            </label>
            <div class="txt">
                <strong>Saldo bajo</strong>
                <span>Cuando el saldo de un hijo baje de @Model.LowBalanceThreshold.ToString("C2").</span>
            </div>
        </div>

        <div class="pref">
            <span class="pico" style="background:#e9f0ff;color:#2f6bff" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="13" rx="3"/><path d="M16 12h3"/></svg>
            </span>
            <label class="sw">
                <input type="checkbox" asp-for="TopUpConfirmed" />
                <span class="track"></span>
            </label>
            <div class="txt">
                <strong>Recarga confirmada</strong>
                <span>Cuando el pago se confirme y el saldo quede acreditado.</span>
            </div>
        </div>

        <div class="pref">
            <span class="pico" style="background:#fff2df;color:#d97706" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L21 7H5.2"/></svg>
            </span>
            <label class="sw">
                <input type="checkbox" asp-for="PurchaseMade" />
                <span class="track"></span>
            </label>
            <div class="txt">
                <strong>Compra en la tienda</strong>
                <span>Cada vez que tu hijo compre algo en la tienda escolar.</span>
            </div>
        </div>

        <div class="pref">
            <span class="pico" style="background:#f1eafe;color:#7c3aed" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 8l8 5 8-5"/></svg>
            </span>
            <label class="sw">
                <input type="checkbox" asp-for="DailySummary" />
                <span class="track"></span>
            </label>
            <div class="txt">
                <strong>Resumen diario</strong>
                <span>Un solo correo al final del día con el consumo de la jornada.</span>
            </div>
        </div>
    </div>

    <div class="card">
        <div style="display:flex;gap:14px;align-items:flex-start">
            <span class="pico" style="background:#e9f0ff;color:#2f6bff" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 8l8 5 8-5"/></svg>
            </span>
            <div>
                <p class="muted" style="margin:0">
                    Los avisos se enviarán a <strong>@(Model.Email ?? "tu correo registrado")</strong>.
                    Puedes cambiarlo en <a href="/Profile">tu perfil</a>.
                </p>
                <p class="muted" style="margin-top:6px">El envío de avisos aún no está activo; por ahora se guarda tu preferencia.</p>
            </div>
        </div>
        <div style="margin-top:16px"><button class="btn" type="submit">Guardar cambios</button></div>
    </div>
</form>
