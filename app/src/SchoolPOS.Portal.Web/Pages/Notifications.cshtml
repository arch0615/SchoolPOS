@page
@model SchoolPOS.Portal.Web.Pages.NotificationsModel
@{
    ViewData["Title"] = "Avisos";
}

@section Head {
    <style>
        .pref { display: flex; align-items: flex-start; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--line); }
        .pref:last-of-type { border-bottom: 0; }
        .pref .txt { flex: 1; min-width: 0; }
        .pref .txt strong { display: block; font-size: 15px; font-weight: 600; }
        .pref .txt span { color: var(--muted); font-size: 13px; }
        /* Interruptor sobre un checkbox real: sin JS y accesible con teclado. */
        .sw { position: relative; flex: 0 0 46px; width: 46px; height: 26px; margin-top: 2px; }
        .sw input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
        .sw .track { position: absolute; inset: 0; background: #cbd5e1; border-radius: 999px; transition: background .15s; pointer-events: none; }
        .sw .track::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px;
                            background: #fff; border-radius: 50%; transition: transform .15s; }
        .sw input:checked + .track { background: var(--primary); }
        .sw input:checked + .track::after { transform: translateX(20px); }
        .sw input:focus-visible + .track { box-shadow: 0 0 0 3px rgba(37,99,235,.35); }
    </style>
}

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="msg ok">@Model.Message</div> }

<div class="page-head">
    <div>
        <div class="eyebrow2">Cuenta</div>
        <h1 style="margin:8px 0 0">Avisos</h1>
        <p class="sub">Elige qué quieres que te avisemos. Puedes cambiarlo cuando quieras.</p>
    </div>
</div>

<form method="post">
    <div class="card">
        <div class="pref">
            <label class="sw">
                <input type="checkbox" asp-for="LowBalance" />
                <span class="track"></span>
            </label>
            <div class="txt">
                <strong>Saldo bajo</strong>
                <span>Cuando el saldo de un hijo baje de @Model.LowBalanceThreshold.ToString("C2").</span>
            </div>
        </div>

        <div class="pref">
            <label class="sw">
                <input type="checkbox" asp-for="TopUpConfirmed" />
                <span class="track"></span>
            </label>
            <div class="txt">
                <strong>Recarga confirmada</strong>
                <span>Cuando el pago se confirme y el saldo quede acreditado.</span>
            </div>
        </div>

        <div class="pref">
            <label class="sw">
                <input type="checkbox" asp-for="PurchaseMade" />
                <span class="track"></span>
            </label>
            <div class="txt">
                <strong>Compra en la tienda</strong>
                <span>Cada vez que tu hijo compre algo en la tienda escolar.</span>
            </div>
        </div>

        <div class="pref">
            <label class="sw">
                <input type="checkbox" asp-for="DailySummary" />
                <span class="track"></span>
            </label>
            <div class="txt">
                <strong>Resumen diario</strong>
                <span>Un solo correo al final del día con el consumo de la jornada.</span>
            </div>
        </div>
    </div>

    <div class="card">
        <p class="muted">
            Los avisos se enviarán a <strong>@(Model.Email ?? "tu correo registrado")</strong>.
            Puedes cambiarlo en <a href="/Profile">tu perfil</a>.
        </p>
        <p class="muted" style="margin-top:8px">El envío de avisos aún no está activo; por ahora se guarda tu preferencia.</p>
        <div style="margin-top:14px"><button class="btn" type="submit">Guardar cambios</button></div>
    </div>
</form>
