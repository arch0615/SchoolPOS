@{
    var authed = User.Identity?.IsAuthenticated ?? false;
    var path = Context.Request.Path.Value ?? "";
    var isVendor = User.HasClaim("portal_role", "vendor");
    var isSchool = User.HasClaim("portal_role", "school");
    var showShell = authed && !isVendor && !isSchool;   // parent app-shell (sidebar)
    var showVendorShell = authed && isVendor;           // vendor app-shell (sidebar)
    var showSchoolShell = authed && isSchool;            // school-store app-shell (sidebar)
    // RBAC de la tienda (refleja PosSession del POS): Cajero / Almacén / Administrador.
    var schoolAdmin = isSchool && User.IsInRole("Admin");
    var schoolInv = isSchool && (User.IsInRole("Admin") || User.IsInRole("Warehouse"));
    var schoolRoleLabel = User.IsInRole("Admin") ? "Administrador" : User.IsInRole("Warehouse") ? "Almacén" : "Cajero";
    var schoolHome = schoolAdmin ? "/School/Store" : (isSchool && User.IsInRole("Warehouse")) ? "/School/Inventory" : "/School/Sales";
    var isLanding = !authed && (path == "/" || path.Equals("/Index", StringComparison.OrdinalIgnoreCase));
    Func<string, bool> isActive = p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LoncherApp</title>
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    @await RenderSectionAsync("Head", required: false)
    <style>
        /* Blue SaaS palette — see WEB-UI-DESIGN-SPEC.md */
        :root {
            --primary: #2563eb; --primary-dark: #1d4ed8; --primary-tint: #eff6ff;
            --success: #10b981; --warning: #f59e0b; --danger: #ef4444;
            --background: #f8fafc; --card: #ffffff;
            --text: #111827; --muted: #64748b; --line: #e5e7eb;
            --radius: 16px;
            /* Back-compat semantic aliases (existing markup stays on-theme) */
            --green: var(--success); --green-dark: var(--primary-dark);
            --orange: var(--warning); --orange-dark: #d97706;
            --cream: #f1f5f9; --cream-line: var(--line); --ink: var(--text);
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: Inter, system-ui, "Segoe UI", Roboto, Arial, sans-serif; color: var(--text); background: var(--background); }
        a { color: var(--primary); text-decoration: none; }
        a:hover { text-decoration: underline; }
        header { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 50; }
        header.scrolled { box-shadow: 0 2px 12px rgba(15,23,42,.08); }
        .bar { max-width: none; margin: 0; display: flex; align-items: center; padding: 12px 28px; gap: 16px; height: 64px; }
        .bar nav { margin-left: auto; }   /* auth info + button hug the right edge */
        .bar .lnav { display: flex; gap: 20px; margin: 0 auto; }
        .bar .lnav a { color: #475569; font-size: 14px; font-weight: 600; }
        .bar .lnav a:hover { color: var(--primary); text-decoration: none; }
        @@media (max-width: 720px) { .bar .lnav { display: none; } }
        .bar .brand { display: inline-flex; align-items: center; }
        .bar .brand img { height: 34px; display: block; }
        .bar nav { margin-left: auto; display: flex; gap: 18px; align-items: center; }
        .bar nav a, .bar nav form button { color: var(--primary); background: none; border: 0; font-size: 14px; font-weight: 600; cursor: pointer; padding: 0; }
        .bar nav a:hover, .bar nav form button:hover { color: var(--primary-dark); text-decoration: none; }
        main { max-width: 960px; margin: 0 auto; padding: 24px 20px 48px; }
        main.landing-main { max-width: none; margin: 0; padding: 0; }
        .card { background: var(--card); border-radius: var(--radius); padding: 24px; margin-bottom: 18px; box-shadow: 0 2px 8px rgba(0,0,0,.05); }
        h1 { font-size: 32px; font-weight: 700; margin: 0 0 6px; color: var(--text); }
        h2 { font-size: 18px; font-weight: 600; margin: 0 0 12px; color: var(--text); }
        label { display: block; font-size: 13px; font-weight: 600; margin: 10px 0 4px; color: var(--muted); }
        input, select { width: 100%; padding: 11px; border: 1px solid var(--line); border-radius: 10px; font-size: 15px; color: var(--text); }
        input:focus, select:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,99,235,.15); }
        .btn { display: inline-block; background: var(--primary); color: #fff; border: 0; border-radius: 10px;
               padding: 12px 18px; min-height: 44px; font-size: 15px; font-weight: 600; cursor: pointer; }
        .btn:hover { background: var(--primary-dark); }
        .btn.accent { background: var(--warning); }
        .btn.accent:hover { background: var(--orange-dark); }
        .btn.danger { background: var(--danger); }
        .btn.danger:hover { background: #dc2626; }
        .btn.ghost { background: #fff; color: var(--primary); border: 1px solid var(--primary); }
        .btn.ghost:hover { background: var(--primary-tint); }
        .row { display: flex; gap: 16px; flex-wrap: wrap; }
        .row > * { flex: 1; min-width: 220px; }
        .balance { font-size: 34px; font-weight: 800; color: var(--primary); }
        /* Gradient balance card (spec §7) — available for the dashboard hero */
        .balance-card { background: linear-gradient(135deg, #2563eb, #3b82f6); color: #fff; padding: 28px; border-radius: 20px; }
        .balance-card .balance { color: #fff; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 9px 8px; border-bottom: 1px solid var(--line); font-size: 14px; }
        th { color: var(--muted); font-weight: 600; }
        .msg { padding: 10px 14px; border-radius: 10px; margin: 8px 0; }
        .msg.error { background: #fef2f2; color: #b91c1c; }
        .msg.ok { background: #ecfdf5; color: #047857; }
        .muted { color: var(--muted); font-size: 13px; }
        .pill { display:inline-block; padding:2px 8px; border-radius:10px; background:var(--primary-tint); color:var(--primary-dark); font-size:12px; }
        .greet { color: var(--muted); font-size: 14px; font-weight: 600; }
        /* App shell — sidebar + content (spec §4) */
        .shell { max-width: none; margin: 0; display: flex; gap: 0; padding: 0; }
        .sidebar { width: 248px; flex: 0 0 248px; padding: 18px 0; background: #fff;
                   border-right: 2px solid #a3bbf1; min-height: calc(100vh - 65px); }
        .sidebar a { display: flex; align-items: center; gap: 12px; padding: 11px 14px; margin-bottom: 4px;
                     border: 2px solid transparent; border-radius: 10px; color: var(--text); font-weight: 600; font-size: 15px; }
        .sidebar a:hover { background: var(--primary-tint); text-decoration: none; }
        .sidebar a.active { background: #b5edca; color: #000; border-color: transparent; border-radius: 0; }
        .sidebar a .ico { width: 20px; text-align: center; }
        main.content { max-width: none; margin: 0; flex: 1 1 auto; min-width: 0; padding: 26px 30px 56px; }
        /* Gradient balance hero — dark-surface controls */
        .balance-card select { background: rgba(255,255,255,.16); color: #fff; border: 1px solid rgba(255,255,255,.45);
                               border-radius: 8px; padding: 8px 10px; font-size: 14px; max-width: 320px; }
        .balance-card select option { color: var(--text); }
        /* Mobile bottom navigation */
        .bottomnav { display: none; }
        @@media (max-width: 860px) {
            .shell { flex-direction: column; gap: 0; padding: 0; }
            .sidebar { display: none; }
            main.content { padding: 16px 16px 84px; }
            .bottomnav { display: flex; position: fixed; left: 0; right: 0; bottom: 0; background: #fff;
                         border-top: 1px solid var(--line); justify-content: space-around; padding: 6px 0; z-index: 20; }
            .bottomnav a { flex: 1; text-align: center; color: var(--muted); font-size: 11px; font-weight: 600; padding: 6px 0; }
            .bottomnav a.active { color: var(--primary); }
            .bottomnav a .ico { display: block; font-size: 19px; line-height: 1.2; }
        }
    </style>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="@(isLanding ? "is-landing" : (showShell || showVendorShell || showSchoolShell) ? "is-app has-shell" : "is-app")">
    @if (showShell || showVendorShell || showSchoolShell)
    {
        <script>try { if (localStorage.getItem('lc_sidebar_collapsed') === '1') document.body.classList.add('sidebar-collapsed'); } catch (e) { }</script>
    }
    <header>
        <div class="bar">
            @if (showShell || showVendorShell || showSchoolShell)
            {
                <a class="brand app-brand" href="@(showShell ? "/Dashboard" : showVendorShell ? "/Vendor/Dashboard" : schoolHome)">
                    <span class="apple" aria-hidden="true">🍎</span><span class="lbl">Loncher<span class="gold">App</span></span>
                </a>
                <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label="Contraer menú" aria-expanded="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            }
            else
            {
                <a class="brand" href="/"><img src="/img/loncherapp-logo.svg" alt="LoncherApp" /></a>
            }
            @if (isLanding)
            {
                <span class="lnav">
                    <a href="#inicio">Inicio</a>
                    <a href="#como-funciona">Cómo funciona</a>
                    <a href="#padres">Para padres</a>
                    <a href="#escuelas">Para escuelas</a>
                    <a href="#seguridad">Seguridad</a>
                    <a href="#faq">FAQ</a>
                </span>
            }
            <nav>
                @if (showShell || showVendorShell || showSchoolShell)
                {
                    var uname = string.IsNullOrWhiteSpace(User.Identity?.Name)
                        ? (showVendorShell ? "Proveedor" : showSchoolShell ? "Tienda" : "Mi cuenta")
                        : User.Identity!.Name;
                    var uparts = uname.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    var uinit = uparts.Length == 0 ? "?"
                        : (uparts[0].Substring(0, 1) + (uparts.Length > 1 ? uparts[1].Substring(0, 1) : "")).ToUpperInvariant();
                    var urole = showVendorShell ? "Panel del proveedor" : showSchoolShell ? $"{schoolRoleLabel} · Tienda" : "Padre / tutor";
                    @if (showShell)
                    {
                        <a class="topbell" href="/Notifications" aria-label="Avisos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg></a>
                    }
                    <div class="usermenu">
                        <button type="button" class="usermenu-btn" id="usermenu-btn" aria-haspopup="true" aria-expanded="false">
                            <span class="um-av" aria-hidden="true">@uinit</span>
                            <span class="um-name">@uname</span>
                            <svg class="um-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <div class="usermenu-pop" role="menu" aria-labelledby="usermenu-btn">
                            <div class="usermenu-head">
                                <div class="n">@uname</div>
                                <div class="r">@urole</div>
                            </div>
                            <div class="usermenu-sep"></div>
                            <button type="button" class="usermenu-item js-open-guide" role="menuitem"><span class="umi-ico" aria-hidden="true">🧭</span> Guía de uso</button>
                            @if (showShell)
                            {
                                <a class="usermenu-item" role="menuitem" href="/Profile"><span class="umi-ico" aria-hidden="true">👤</span> Mi perfil</a>
                            }
                            <a class="usermenu-item danger" role="menuitem" href="/Account/Logout"><span class="umi-ico" aria-hidden="true">⏻</span> Cerrar sesión</a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Account/Login">Ingresar</a>
                    <a href="/Account/Register">Registrarse</a>
                }
            </nav>
        </div>
    </header>
    @if (showShell)
    {
        <div class="shell">
            <aside class="sidebar">
                <div class="side-nav">
                    <a href="/Dashboard" class="@(isActive("/Dashboard") ? "active" : "")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg><span class="lbl"> Inicio</span></a>
                    <a href="/Wallet" class="@(isActive("/Wallet") ? "active" : "")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="13" rx="3"/><path d="M16 12h3"/></svg><span class="lbl"> Monedero</span></a>
                    <a href="/Students" class="@(isActive("/Students") ? "active" : "")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg><span class="lbl"> Mis alumnos</span></a>
                    <a href="/Transactions" class="@(isActive("/Transactions") ? "active" : "")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg><span class="lbl"> Movimientos</span></a>
                    <a href="/Notifications" class="@(isActive("/Notifications") ? "active" : "")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M18 16v-5a6 6 0 1 0-12 0v5l-2 2h16z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg><span class="lbl"> Avisos</span></a>
                    <a href="/Profile" class="@(isActive("/Profile") ? "active" : "")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M5 21a7 7 0 0 1 14 0"/></svg><span class="lbl"> Perfil</span></a>
                </div>
                <div class="side-support">
                    <img src="/img/il/il-support.svg" alt="" />
                    <div class="ss-t">Guía de uso</div>
                    <div class="ss-s">Conoce las páginas de tu cuenta</div>
                    <button type="button" class="ss-b js-open-guide"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-6 2 2-6z"/></svg> Ver guía</button>
                    <a class="ss-link" href="mailto:soporte@@bulldogti.com">¿Necesitas ayuda? Contactar soporte</a>
                </div>
            </aside>
            <main class="content">
                @RenderBody()
            </main>
        </div>
        <nav class="bottomnav">
            <a href="/Dashboard" class="@(isActive("/Dashboard") ? "active" : "")"><span class="ico">🏠</span>Inicio</a>
            <a href="/Wallet" class="@(isActive("/Wallet") ? "active" : "")"><span class="ico">💳</span>Monedero</a>
            <a href="/Students" class="@(isActive("/Students") ? "active" : "")"><span class="ico">🎒</span>Alumnos</a>
            <a href="/Transactions" class="@(isActive("/Transactions") ? "active" : "")"><span class="ico">📄</span>Movimientos</a>
            <a href="/Profile" class="@(isActive("/Profile") ? "active" : "")"><span class="ico">👤</span>Perfil</a>
        </nav>
    }
    else if (showVendorShell)
    {
        <div class="shell">
            <aside class="sidebar">
                <a href="/Vendor/Dashboard" class="@(isActive("/Vendor/Dashboard") || isActive("/Vendor/Index") ? "active" : "")"><span class="ico">📊</span><span class="lbl"> Panel</span></a>
                <a href="/Vendor/Store" class="@(isActive("/Vendor/Store") ? "active" : "")"><span class="ico">🛒</span><span class="lbl"> Tienda</span></a>
                <a href="/Vendor/Schools" class="@(isActive("/Vendor/Schools") ? "active" : "")"><span class="ico">🏫</span><span class="lbl"> Escuelas</span></a>
                <a href="/Vendor/Commissions" class="@(isActive("/Vendor/Commissions") ? "active" : "")"><span class="ico">💰</span><span class="lbl"> Comisiones</span></a>
                <a href="/Vendor/Invoices" class="@(isActive("/Vendor/Invoices") ? "active" : "")"><span class="ico">🧾</span><span class="lbl"> Facturas</span></a>
                <a href="/Vendor/Connections" class="@(isActive("/Vendor/Connections") ? "active" : "")"><span class="ico">🔗</span><span class="lbl"> Conexiones</span></a>
            </aside>
            <main class="content">
                @RenderBody()
            </main>
        </div>
        <nav class="bottomnav">
            <a href="/Vendor/Dashboard" class="@(isActive("/Vendor/Dashboard") || isActive("/Vendor/Index") ? "active" : "")"><span class="ico">📊</span>Panel</a>
            <a href="/Vendor/Store" class="@(isActive("/Vendor/Store") ? "active" : "")"><span class="ico">🛒</span>Tienda</a>
            <a href="/Vendor/Schools" class="@(isActive("/Vendor/Schools") ? "active" : "")"><span class="ico">🏫</span>Escuelas</a>
            <a href="/Vendor/Commissions" class="@(isActive("/Vendor/Commissions") ? "active" : "")"><span class="ico">💰</span>Comisiones</a>
            <a href="/Vendor/Invoices" class="@(isActive("/Vendor/Invoices") ? "active" : "")"><span class="ico">🧾</span>Facturas</a>
            <a href="/Vendor/Connections" class="@(isActive("/Vendor/Connections") ? "active" : "")"><span class="ico">🔗</span>Conexiones</a>
        </nav>
    }
    else if (showSchoolShell)
    {
        <div class="shell">
            <aside class="sidebar">
                @if (schoolAdmin)
                {
                    <a href="/School/Store" class="@(isActive("/School/Store") ? "active" : "")"><span class="ico">🛒</span><span class="lbl"> Mi tienda</span></a>
                }
                <a href="/School/Sales" class="@(isActive("/School/Sales") ? "active" : "")"><span class="ico">🧾</span><span class="lbl"> Ventas</span></a>
                @if (schoolInv)
                {
                    <a href="/School/Inventory" class="@(isActive("/School/Inventory") ? "active" : "")"><span class="ico">📦</span><span class="lbl"> Inventario</span></a>
                }
                @if (schoolAdmin)
                {
                    <a href="/School/Reports" class="@(isActive("/School/Reports") ? "active" : "")"><span class="ico">📈</span><span class="lbl"> Reportes</span></a>
                }
            </aside>
            <main class="content">
                @RenderBody()
            </main>
        </div>
        <nav class="bottomnav">
            @if (schoolAdmin)
            {
                <a href="/School/Store" class="@(isActive("/School/Store") ? "active" : "")"><span class="ico">🛒</span>Tienda</a>
            }
            <a href="/School/Sales" class="@(isActive("/School/Sales") ? "active" : "")"><span class="ico">🧾</span>Ventas</a>
            @if (schoolInv)
            {
                <a href="/School/Inventory" class="@(isActive("/School/Inventory") ? "active" : "")"><span class="ico">📦</span>Inventario</a>
            }
            @if (schoolAdmin)
            {
                <a href="/School/Reports" class="@(isActive("/School/Reports") ? "active" : "")"><span class="ico">📈</span>Reportes</a>
            }
        </nav>
    }
    else if (isLanding)
    {
        <main class="landing-main">
            @RenderBody()
        </main>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }
    @{
        // Guía de uso: mismas condiciones que arman cada sidebar, así la guía nunca puede
        // mostrar una página que el rol actual no tiene permiso de abrir.
        var guideItems = new List<(string Href, string Icon, string Title, string Desc)>();
        if (showShell)
        {
            guideItems.Add(("/Dashboard", "🏠", "Inicio", "Resumen de saldo y accesos rápidos."));
            guideItems.Add(("/Wallet", "💳", "Monedero", "Recarga el saldo del monedero de tus hijos."));
            guideItems.Add(("/Students", "🎒", "Mis alumnos", "Vincula alumnos y consulta su saldo."));
            guideItems.Add(("/Transactions", "📄", "Movimientos", "Historial de recargas y consumos, día por día."));
            guideItems.Add(("/Notifications", "🔔", "Avisos", "Elige qué notificaciones quieres recibir."));
            guideItems.Add(("/Profile", "👤", "Perfil", "Tus datos, contraseña y avisos."));
        }
        else if (showVendorShell)
        {
            guideItems.Add(("/Vendor/Dashboard", "📊", "Panel", "Resumen de comisiones y actividad de todas las escuelas."));
            guideItems.Add(("/Vendor/Store", "🛒", "Tienda", "Ventas, caja e inventario de todas las escuelas."));
            guideItems.Add(("/Vendor/Schools", "🏫", "Escuelas", "Escuelas registradas y su estado de cobro."));
            guideItems.Add(("/Vendor/Commissions", "💰", "Comisiones", "Desglose por escuela y emisión de CFDI."));
            guideItems.Add(("/Vendor/Invoices", "🧾", "Facturas", "Facturas de comisión emitidas."));
            guideItems.Add(("/Vendor/Connections", "🔗", "Conexiones", "Conexión de cobro por escuela (Mercado Pago)."));
        }
        else if (showSchoolShell)
        {
            if (schoolAdmin) { guideItems.Add(("/School/Store", "🛒", "Mi tienda", "Panel general de tu tienda escolar.")); }
            guideItems.Add(("/School/Sales", "🧾", "Ventas", "Consulta los tickets de venta registrados."));
            if (schoolInv) { guideItems.Add(("/School/Inventory", "📦", "Inventario", "Productos y existencias de tu escuela.")); }
            if (schoolAdmin) { guideItems.Add(("/School/Reports", "📈", "Reportes", "Reportes de ventas por periodo.")); }
        }
        var guideRole = showVendorShell ? "Panel del proveedor" : showSchoolShell ? $"{schoolRoleLabel} · Tienda escolar" : showShell ? "Padre / tutor" : null;
    }
    @if (guideRole is not null)
    {
        <div class="guide-overlay" id="guide-overlay" hidden>
            <div class="guide-modal" role="dialog" aria-modal="true" aria-labelledby="guide-title">
                <button type="button" class="guide-close" id="guide-close" aria-label="Cerrar guía">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
                <div class="guide-head">
                    <div class="eyebrow2">@guideRole</div>
                    <h2 id="guide-title">Guía de uso</h2>
                    <p class="sub">Estas son las páginas disponibles para tu cuenta.</p>
                </div>
                <div class="guide-list">
                    @foreach (var it in guideItems)
                    {
                        <a class="guide-item" href="@it.Href">
                            <span class="gi-ico" aria-hidden="true">@it.Icon</span>
                            <span class="gi-txt"><b>@it.Title</b><span>@it.Desc</span></span>
                            <svg class="gi-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
    <script>
        (function () {
            var um = document.querySelector('.usermenu');
            if (!um) return;
            var btn = um.querySelector('.usermenu-btn');
            function close() { um.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var open = um.classList.toggle('open');
                btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
            document.addEventListener('click', function (e) { if (!um.contains(e.target)) close(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
        })();
        (function () {
            var overlay = document.getElementById('guide-overlay');
            if (!overlay) return;
            var closeBtn = document.getElementById('guide-close');
            var triggers = document.querySelectorAll('.js-open-guide');
            var lastFocus = null;
            function open(e) {
                if (e) { e.preventDefault(); }
                var um = document.querySelector('.usermenu');
                if (um) { um.classList.remove('open'); }
                lastFocus = document.activeElement;
                overlay.hidden = false;
                document.body.style.overflow = 'hidden';
                closeBtn.focus();
            }
            function close() {
                overlay.hidden = true;
                document.body.style.overflow = '';
                if (lastFocus) { lastFocus.focus(); }
            }
            triggers.forEach(function (t) { t.addEventListener('click', open); });
            closeBtn.addEventListener('click', close);
            overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !overlay.hidden) close(); });
        })();
        (function () {
            var toggle = document.getElementById('sidebar-toggle');
            if (!toggle) return;
            function sync() {
                var collapsed = document.body.classList.contains('sidebar-collapsed');
                toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                toggle.setAttribute('aria-label', collapsed ? 'Expandir menú' : 'Contraer menú');
            }
            toggle.addEventListener('click', function () {
                var collapsed = document.body.classList.toggle('sidebar-collapsed');
                try { localStorage.setItem('lc_sidebar_collapsed', collapsed ? '1' : '0'); } catch (e) { }
                sync();
            });
            sync();
        })();
    </script>
</body>
</html>
