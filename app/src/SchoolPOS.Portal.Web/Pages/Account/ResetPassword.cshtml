@page
@model SchoolPOS.Portal.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}
@section Head {
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
}

<div class="auth-wrap">
    <div class="auth-card">
        <aside class="auth-brand">
            <div class="logo"><span class="dot">🍎</span> LoncherApp</div>
            <h2>Crea una nueva contraseña</h2>
            <p class="tag">Elige una contraseña segura para volver a administrar el saldo escolar.</p>
            <ul>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Mínimo 6 caracteres</li>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Usa una que no reutilices en otros sitios</li>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Tu sesión quedará protegida</li>
            </ul>
        </aside>

        <div class="auth-form">
            <h1>Restablecer contraseña</h1>
            <p class="sub">Escribe tu nueva contraseña para terminar.</p>

            @if (!string.IsNullOrEmpty(Model.Error)) { <div class="msg error">@Model.Error</div> }

            <form method="post">
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <label>Nueva contraseña (mínimo 6 caracteres)</label>
                <input asp-for="NewPassword" type="password" placeholder="••••••••" autofocus />
                <button class="btn" type="submit">Guardar contraseña</button>
                <p class="alt"><a href="/Account/Login">← Volver a ingresar</a></p>
            </form>
        </div>
    </div>
</div>
