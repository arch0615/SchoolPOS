@page
@model SchoolPOS.Portal.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Ingresar";
}
@section Head {
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
}

<div class="auth-wrap">
    <div class="auth-card">
        <aside class="auth-brand">
            <div class="logo"><span class="dot">🍎</span> LoncherApp</div>
            <h2>Bienvenido de nuevo</h2>
            <p class="tag">Administra el saldo escolar de tus hijos desde un solo lugar.</p>
            <ul>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Recarga en segundos</li>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Saldo y movimientos en tiempo real</li>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Pago seguro con Mercado Pago</li>
            </ul>
        </aside>

        <div class="auth-form">
            <h1>Ingresar</h1>
            <p class="sub">Accede a tu cuenta de padre o tutor.</p>

            @if (TempData["LoginMessage"] is string okMsg) { <div class="msg ok">@okMsg</div> }
            @if (!string.IsNullOrEmpty(Model.Error)) { <div class="msg error">@Model.Error</div> }

            <form method="post">
                <label>Escuela</label>
                <select asp-for="Input.SchoolId"
                        asp-items="@(new SelectList(Model.Schools, nameof(SchoolDirectory.Option.Id), nameof(SchoolDirectory.Option.Name)))">
                    <option value="">Selecciona tu escuela…</option>
                </select>
                <label>Correo electrónico</label>
                <input asp-for="Input.Email" type="email" placeholder="tu@correo.com" autofocus />
                <label>Contraseña</label>
                <input asp-for="Input.Password" type="password" placeholder="••••••••" />
                <a class="forgot" href="/Account/ForgotPassword">¿Olvidaste tu contraseña?</a>
                <button class="btn" type="submit">Entrar</button>
                <p class="alt">¿No tienes cuenta? <a href="/Account/Register">Crear cuenta</a></p>
            </form>
        </div>
    </div>
</div>
