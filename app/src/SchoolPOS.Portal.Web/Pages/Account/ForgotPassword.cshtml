@page
@model SchoolPOS.Portal.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}
@section Head {
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
}

<div class="auth-wrap">
    <div class="auth-card">
        <aside class="auth-brand">
            <div class="logo"><span class="dot">🍎</span> LoncherApp</div>
            <h2>¿Olvidaste tu contraseña?</h2>
            <p class="tag">Te enviaremos un enlace seguro para crear una nueva y volver a tu cuenta.</p>
            <ul>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Enlace válido por tiempo limitado</li>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Tu saldo y datos siguen protegidos</li>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Sin costo y en segundos</li>
            </ul>
        </aside>

        <div class="auth-form">
            @if (Model.Submitted)
            {
                <h1>Revisa tu correo</h1>
                <p class="sub">Si el correo está registrado, enviamos instrucciones para restablecer la contraseña.</p>
                <div class="msg ok">Revisa tu bandeja de entrada (y la carpeta de spam).</div>
                @if (Model.DevResetLink is not null)
                {
                    <p class="muted" style="margin-top:8px">Modo desarrollo — enlace de restablecimiento (en producción se envía por correo):</p>
                    <p><a class="forgot" href="@Model.DevResetLink">Restablecer contraseña →</a></p>
                }
                <p class="alt"><a href="/Account/Login">← Volver a ingresar</a></p>
            }
            else
            {
                <h1>Recuperar contraseña</h1>
                <p class="sub">Ingresa tu correo y te enviaremos un enlace para restablecerla.</p>

                <form method="post">
                    <label>Correo electrónico</label>
                    <input asp-for="Email" type="email" placeholder="tu@correo.com" autofocus />
                    <button class="btn" type="submit">Enviar enlace</button>
                    <p class="alt">¿Ya la recordaste? <a href="/Account/Login">Ingresar</a></p>
                </form>
            }
        </div>
    </div>
</div>
