@page
@model SchoolPOS.Portal.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registro";
}
@section Head {
    <link rel="stylesheet" href="/css/auth.css" asp-append-version="true" />
}

<div class="auth-wrap">
    <div class="auth-card">
        <aside class="auth-brand">
            <div class="logo"><span class="dot">🍎</span> LoncherApp</div>
            <h2>Crea tu cuenta y empieza</h2>
            <p class="tag">Regístrate como padre o tutor y vincula a tu hijo por su matrícula.</p>
            <ul>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Sin efectivo, sin filas</li>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Varios hijos en una cuenta</li>
                <li><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> El saldo se abona al 100%</li>
            </ul>
        </aside>

        <div class="auth-form">
            <h1>Crear cuenta</h1>
            <p class="sub">Es gratis y toma menos de un minuto.</p>

            @if (!string.IsNullOrEmpty(Model.Error)) { <div class="msg error">@Model.Error</div> }

            <form method="post">
                <label>Escuela</label>
                <select asp-for="Input.SchoolId"
                        asp-items="@(new SelectList(Model.Schools, nameof(SchoolDirectory.Option.Id), nameof(SchoolDirectory.Option.Name)))">
                    <option value="">Selecciona la escuela…</option>
                </select>
                <label>Nombre completo</label>
                <input asp-for="Input.FullName" placeholder="María López" autofocus />
                <label>Correo electrónico</label>
                <input asp-for="Input.Email" type="email" placeholder="tu@correo.com" />
                <label>Contraseña <span style="font-weight:400">(mínimo 6 caracteres)</span></label>
                <div class="pwd-wrap">
                    <input asp-for="Input.Password" type="password" placeholder="••••••••" />
                    <button type="button" class="pwd-toggle" data-target="Input_Password" aria-label="Mostrar contraseña">👁</button>
                </div>

                <label class="check"><input asp-for="Input.AcceptTerms" type="checkbox" /> Acepto los <a href="/Legal/Terms" target="_blank">Términos y condiciones</a></label>
                <label class="check"><input asp-for="Input.AcceptPrivacy" type="checkbox" /> Acepto el <a href="/Legal/PrivacyNotice" target="_blank">Aviso de Privacidad</a></label>
                <label class="check"><input asp-for="Input.AcceptNotifications" type="checkbox" /> Quiero recibir notificaciones (saldo bajo, recargas confirmadas)</label>

                <button class="btn" type="submit">Registrarme</button>
                <p class="alt">¿Ya tienes cuenta? <a href="/Account/Login">Ingresar</a></p>
            </form>
        </div>
    </div>
</div>
<script src="/js/password-toggle.js" asp-append-version="true"></script>
