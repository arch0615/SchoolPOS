@page
@model SchoolPOS.Portal.Web.Pages.DashboardModel
@{
    ViewData["Title"] = "Mi panel";
}

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="msg ok">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="msg error">@Model.Error</div> }

@if (Model.Students.Count == 0)
{
    <div class="card">
        <h1>Bienvenido</h1>
        <p class="muted">Aún no has vinculado a ningún alumno. Vincula uno con su matrícula para ver su saldo y recargarlo.</p>
        <div style="margin-top:12px"><a class="btn" href="/Students">Vincular un alumno</a></div>
    </div>
}
else
{
    <section class="balance-card">
        <div class="row" style="align-items:center">
            <div>
                <div style="opacity:.85;font-size:14px">Saldo disponible</div>
                <div class="balance">@((Model.Selected?.Balance ?? 0).ToString("C2"))</div>
                <div style="opacity:.9;font-size:13px;margin-top:2px">@Model.Selected?.FullName · @Model.Selected?.EnrollmentNo</div>
            </div>
            <div style="text-align:right">
                <div style="opacity:.85;font-size:13px;margin-bottom:6px">Cambiar estudiante</div>
                <form method="get">
                    <select name="studentId" onchange="this.form.submit()">
                        @foreach (var s in Model.Students)
                        {
                            <option value="@s.StudentId" selected="@(Model.Selected?.StudentId == s.StudentId)">
                                @s.FullName · @s.EnrollmentNo
                            </option>
                        }
                    </select>
                </form>
            </div>
        </div>
    </section>

    <div class="row">
        <div class="card">
            <h2>Recargar saldo</h2>
            <p class="muted">Abona saldo con tarjeta, transferencia o efectivo. El estudiante recibe el 100% del monto recargado.</p>
            <div style="margin-top:12px">
                <a class="btn accent" href="/Wallet?studentId=@Model.Selected!.StudentId">Ir al monedero</a>
            </div>
        </div>
        <div class="card">
            <h2>Mis alumnos</h2>
            <p class="muted">@Model.Students.Count @(Model.Students.Count == 1 ? "alumno vinculado" : "alumnos vinculados"). Consulta su saldo o vincula uno nuevo.</p>
            <div style="margin-top:12px"><a class="btn ghost" href="/Students">Ver mis alumnos</a></div>
        </div>
    </div>

    <div class="card">
        <h2>Movimientos recientes</h2>
        @if (Model.Movements.Count == 0)
        {
            <p class="muted">Sin movimientos todavía.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Fecha (UTC)</th><th>Tipo</th><th style="text-align:right">Importe</th><th style="text-align:right">Saldo</th></tr></thead>
                <tbody>
                @foreach (var m in Model.Movements)
                {
                    <tr>
                        <td>@m.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="pill">@m.Type</span></td>
                        <td style="text-align:right;color:@(m.Amount < 0 ? "var(--danger)" : "var(--success)")">@m.Amount.ToString("C2")</td>
                        <td style="text-align:right">@m.BalanceAfter.ToString("C2")</td>
                    </tr>
                }
                </tbody>
            </table>
            <p style="margin-top:10px"><a href="/Transactions?StudentId=@Model.Selected!.StudentId">Ver historial completo →</a></p>
        }
    </div>
}
