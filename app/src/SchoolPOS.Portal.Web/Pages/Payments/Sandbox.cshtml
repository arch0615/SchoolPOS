@page
@model SchoolPOS.Portal.Web.Pages.Payments.SandboxModel
@{
    ViewData["Title"] = "Pago (simulación)";
}
<div class="card receipt">
    <div class="eyebrow2">Simulación · pasarela de prueba</div>
    <div class="ricon pending" aria-hidden="true">💳</div>
    <h1 style="margin:0">Confirmar pago</h1>
    <p class="muted">Simulación de Mercado Pago (desarrollo). En producción, aquí estaría el checkout
        real con split de comisión.</p>

    <div class="amt">@Model.Amount.ToString("C2")</div>
    <div class="rows">
        <div class="rrow"><span>Referencia</span><strong>@Model.Reference</strong></div>
        <div class="rrow"><span>Método</span><strong>Mercado Pago (sandbox)</strong></div>
    </div>

    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
        <form method="post" asp-page-handler="Approve">
            <input type="hidden" name="reference" value="@Model.Reference" />
            <button class="btn accent" type="submit">Pagar (aprobar)</button>
        </form>
        <form method="post" asp-page-handler="Reject">
            <input type="hidden" name="reference" value="@Model.Reference" />
            <button class="btn danger" type="submit">Rechazar</button>
        </form>
    </div>
</div>
