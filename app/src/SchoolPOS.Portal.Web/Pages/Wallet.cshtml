@page
@model SchoolPOS.Portal.Web.Pages.WalletModel
@{
    ViewData["Title"] = "Monedero";
}

@section Head {
    <style>
        .amounts { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }
        .amounts button { flex: 1 1 0; min-width: 90px; padding: 14px 10px; border: 1px solid var(--line);
                          background: #fff; border-radius: 12px; font-size: 16px; font-weight: 700;
                          color: var(--text); cursor: pointer; }
        .amounts button:hover { border-color: var(--primary); color: var(--primary); }
        .amounts button[aria-pressed="true"] { border-color: var(--primary); background: var(--primary-tint); color: var(--primary-dark); }
        .method { display: flex; align-items: center; gap: 12px; padding: 14px; border: 1px solid var(--primary);
                  background: var(--primary-tint); border-radius: 12px; }
        .method .ico { font-size: 22px; }
        .method strong { display: block; font-size: 15px; }
    </style>
}

@if (!string.IsNullOrEmpty(Model.Message)) { <div class="msg ok">@Model.Message</div> }
@if (!string.IsNullOrEmpty(Model.Error)) { <div class="msg error">@Model.Error</div> }

<h1>Monedero</h1>

@if (Model.Selected is null)
{
    <div class="card">
        <p class="muted">Aún no has vinculado a ningún alumno, así que no hay saldo que recargar.</p>
        <p style="margin-top:12px"><a class="btn" href="/Students">Vincular un alumno</a></p>
    </div>
}
else
{
    <section class="balance-card">
        <div class="row" style="align-items:center">
            <div>
                <div style="opacity:.85;font-size:14px">Saldo disponible</div>
                <div class="balance">@Model.Selected.Balance.ToString("C2")</div>
                <div style="opacity:.9;font-size:13px;margin-top:2px">@Model.Selected.FullName · @Model.Selected.EnrollmentNo</div>
            </div>
            @if (Model.Students.Count > 1)
            {
                <div style="text-align:right">
                    <div style="opacity:.85;font-size:13px;margin-bottom:6px">Cambiar estudiante</div>
                    <form method="get">
                        <select name="studentId" onchange="this.form.submit()" aria-label="Estudiante">
                            @foreach (var s in Model.Students)
                            {
                                <option value="@s.StudentId" selected="@(Model.Selected.StudentId == s.StudentId)">
                                    @s.FullName · @s.EnrollmentNo
                                </option>
                            }
                        </select>
                    </form>
                </div>
            }
        </div>
    </section>

    <div class="card">
        <h2>Recargar saldo</h2>
        <form method="post" asp-page-handler="TopUp">
            <input type="hidden" name="studentId" value="@Model.Selected.StudentId" />
            <input type="hidden" name="accountId" value="@Model.Selected.AccountId" />

            <label id="lbl-monto">Monto (MXN)</label>
            <div class="amounts" role="group" aria-labelledby="lbl-monto">
                @foreach (var p in Model.Presets)
                {
                    <button type="button" class="preset" data-amount="@p.ToString("0.##")" aria-pressed="false">@p.ToString("C0")</button>
                }
            </div>
            <input id="amount" name="amount" type="number" inputmode="decimal"
                   min="@Model.MinTopUp.ToString("0.##")" max="@Model.MaxTopUp.ToString("0.##")" step="1"
                   value="@Model.Presets.First().ToString("0.##")" required aria-label="Otro monto" />
            <p class="muted">Entre @Model.MinTopUp.ToString("C2") y @Model.MaxTopUp.ToString("C2"). El estudiante recibe el 100% del monto recargado.</p>

            <label>Método de pago</label>
            <div class="method">
                <span class="ico" aria-hidden="true">💳</span>
                <span>
                    <strong>Mercado Pago</strong>
                    <span class="muted">Tarjeta, transferencia o efectivo en tiendas</span>
                </span>
            </div>

            <div style="margin-top:18px"><button class="btn accent" type="submit">Continuar al pago</button></div>
        </form>
    </div>

    <div class="card">
        <h2>Últimas recargas</h2>
        @if (Model.Recent.Count == 0)
        {
            <p class="muted">Sin recargas todavía.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Fecha (UTC)</th><th style="text-align:right">Importe</th><th style="text-align:right">Saldo</th></tr></thead>
                <tbody>
                @foreach (var m in Model.Recent)
                {
                    <tr>
                        <td>@m.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="text-align:right;color:var(--success)">@m.Amount.ToString("C2")</td>
                        <td style="text-align:right">@m.BalanceAfter.ToString("C2")</td>
                    </tr>
                }
                </tbody>
            </table>
            <p style="margin-top:10px"><a href="/Transactions?StudentId=@Model.Selected.StudentId&amp;Kind=TopUps">Ver todas las recargas →</a></p>
        }
    </div>

    <script>
        // Los botones sugeridos sólo rellenan el campo; el monto enviado siempre es el del input.
        (function () {
            var input = document.getElementById('amount');
            var presets = document.querySelectorAll('.preset');
            function sync() {
                presets.forEach(function (b) {
                    b.setAttribute('aria-pressed', String(b.dataset.amount === input.value));
                });
            }
            presets.forEach(function (b) {
                b.addEventListener('click', function () { input.value = b.dataset.amount; sync(); });
            });
            input.addEventListener('input', sync);
            sync();
        })();
    </script>
}
